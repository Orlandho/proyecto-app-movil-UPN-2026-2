<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos para Android 12+ (API 31+).
    En Android 12+, android:allowBackup="false" no bloquea transferencias
    dispositivo-a-dispositivo (D2D); por ello ambas secciones (<cloud-backup> y
    <device-transfer>) excluyen explícitamente el directorio de DataStore
    (files/datastore/foodjet_session.preferences_pb), la base de datos Room y
    las preferencias compartidas para evitar transferencia de credenciales o
    estados de sesión inconsistentes.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
