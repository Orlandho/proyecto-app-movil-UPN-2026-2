<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de respaldo para Android 10 y 11 (API 29-30).
    Defensa en profundidad junto con android:allowBackup="false":
    - Excluye el directorio datastore/ donde Jetpack DataStore persiste
      foodjet_session.preferences_pb (JWT cifrado con Android Keystore y PII de sesión).
    - Excluye bases de datos locales (caché Room foodjet_database.db) y SharedPreferences.
-->
<full-backup-content>
    <exclude domain="file" path="datastore" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
