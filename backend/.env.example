DATABASE_URL="mysql://root:password@localhost:3306/foodjet"
JWT_SECRET="secret"
PORT=3000

# Google Maps API Keys (entregadas al frontend y a la app móvil vía GET /api/config)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_SECUNDARIA=

# Simulación del pedido (seguimiento en vivo). Sin SIMULAR_PEDIDOS=true los
# pedidos nuevos no avanzan solos y el seguimiento se queda en el primer estado.
SIMULAR_PEDIDOS=true
# Cuántas veces más rápido que la realidad (10 = un pedido urbano en ~3 min)
SIM_ESCALA_TIEMPO=10
# Servicio de rutas por calles; si no responde, la ruta cae a línea recta
OSRM_URL=https://router.project-osrm.org
# Solo con ENABLE_JOBS=true: simulador antiguo (pedidos sin plan) y
# auto-cancelación de pedidos en efectivo sin confirmar tras estos minutos.
ENABLE_JOBS=false
AUTO_CANCEL_MINUTES=30
